{
  // Not a bare `alt-r`: that is recent-list's key in the reveal tier, and an
  // editor-scoped binding sits on a deeper element than a workspace-scoped one,
  // so it would have taken alt-r whenever an editor had focus — which is most
  // of the time.
  "lumine-text-editor:not([mini])": {
    "cmdorctrl-alt-r": "regex-aligner:toggle"
  }
}
