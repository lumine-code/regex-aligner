{
  "name": "regex-aligner",
  "author": "lumine-code",
  "description": "Align text using regular expressions or multiple cursors.",
  "repository": "https://github.com/lumine-code/regex-aligner",
  "bugs": {
    "url": "https://github.com/lumine-code/regex-aligner/issues"
  },
  "keywords": [
    "tabularize",
    "column",
    "spacing",
    "multi-cursor",
    "indent"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "cd ../../lumine && npm run test:only -- ../pkg_lumine/regex-aligner/spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationCommands": {
    "atom-text-editor:not([mini])": [
      "regex-aligner:toggle",
      "regex-aligner:simple"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
